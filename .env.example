# Variables de entorno de SportPG
# - En Vercel: cópialas en Project > Settings > Environment Variables (entorno Production).
# - En local NO hacen falta: sin ellas se usa SQLite e imágenes en media/.
#   (Si quieres probar algo en local, copia este archivo como .env; nunca lo subas a git.)

# --- Django -------------------------------------------------------------------------
# Siempre 0 en Vercel (modo producción). Solo pon 1 un momento para diagnosticar un error.
DJANGO_DEBUG=0
# Clave secreta larga y aleatoria (genera una con el comando del README).
DJANGO_SECRET_KEY=

# Dominio propio adicional, si lo tienes (los *.vercel.app ya están permitidos). Opcional.
DJANGO_ALLOWED_HOSTS=

# --- Supabase: base de datos ----------------------------------------------------------
# Supabase > Connect > ORMs/Connection string > "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase: almacenamiento de imágenes -----------------------------------------------
# Project URL (Supabase > Project Settings > Data API o API).
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Nombre del bucket PÚBLICO creado en Storage.
SUPABASE_STORAGE_BUCKET=media
# Storage > S3 Configuration (o Settings > Storage): región y claves de acceso S3.
SUPABASE_S3_REGION=us-east-1
# Opcional: copia aquí el "Endpoint" que muestra Storage > S3 si es distinto de <SUPABASE_URL>/storage/v1/s3
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Primer despliegue -----------------------------------------------------------------
# Cuenta de administración que se crea automáticamente (si no existe).
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
# 1 = cargar catálogo de ejemplo, sucursales y clienta de prueba (no duplica datos).
CARGAR_DEMO=1

# --- Tarea diaria contra la pausa de Supabase -----------------------------------------
# Cadena aleatoria de al menos 16 caracteres.
CRON_SECRET=
